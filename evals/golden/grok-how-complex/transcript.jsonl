{"type": "tool_call", "toolCallId": "call-5b0a8867-fe67-408a-a5e5-7d64c92ec315-16", "title": "run_terminal_command", "kind": "execute", "status": "pending", "toolName": "run_terminal_command", "rawInput": {"command": "node --input-type=module -e '\nimport { convertMinor, toMinor, fromMinor, digits } from \"./src/money/currency.js\";\nimport { roundMinor, ROUNDING } from \"./src/money/round.js\";\nimport { computeTax } from \"./src/tax/compute.js\";\n\nconst cases = [\n  [\"half-up 2.5\", roundMinor(2.5)],\n  [\"half-up 3.5\", roundMinor(3.5)],\n  [\"half-even 2.5\", roundMinor(2.5, ROUNDING.HALF_EVEN)],\n  [\"half-even 3.5\", roundMinor(3.5, ROUNDING.HALF_EVEN)],\n  [\"half-even -1.5\", roundMinor(-1.5, ROUNDING.HALF_EVEN)],\n  [\"half-up -1.5\", roundMinor(-1.5)],\n  [\"down 2.9\", roundMinor(2.9, ROUNDING.DOWN)],\n  [\"down -1.1\", roundMinor(-1.1, ROUNDING.DOWN)],\n  [\"near half below\", roundMinor(2.5 - 2e-9)],\n  [\"near half within\", roundMinor(2.5 - 5e-10, ROUNDING.HALF_EVEN)],\n  [\"eur45 to usd\", convertMinor(4500, \"EUR\", \"USD\")],\n  [\"eur45 to gbp\", convertMinor(4500, \"EUR\", \"GBP\")],\n  [\"eur45 to jpy\", convertMinor(4500, \"EUR\", \"JPY\")],\n  [\"eur45 to bhd\", convertMinor(4500, \"EUR\", \"BHD\")],\n  [\"usd100 to eur\", convertMinor(10000, \"USD\", \"EUR\")],\n  [\"eur back\", convertMinor(convertMinor(10000, \"USD\", \"EUR\"), \"EUR\", \"USD\")],\n  [\"jpy1 to usd\", convertMinor(1, \"JPY\", \"USD\")],\n  [\"same usd\", convertMinor(10000, \"USD\", \"USD\")],\n  [\"0.0725*200\", 200 * 0.0725],\n  [\"0.19*5\", 5 * 0.19],\n  [\"0.19*50\", 50 * 0.19],\n];\nfor (const [k,v] of cases) console.log(k, v);\n\n// CA invoice-level vs if it were per line: two lines 100 and 100 cents? use amounts where per-line differs\nconst lines = [\n  { category: \"goods\", amountMinor: 100 },\n  { category: \"goods\", amountMinor: 100 },\n  { category: \"services\", amountMinor: 5000 },\n];\nconsole.log(\"US-CA\", computeTax(lines, \"US-CA\"));\nconsole.log(\"US-OR\", computeTax(lines, \"US-OR\"));\nconsole.log(\"DE\", computeTax(lines, \"DE\"));\nconsole.log(\"GB\", computeTax(lines, \"GB\"));\n\n// find a half-even tie for 19%\nfor (let n = 1; n < 500; n++) {\n  const t = n * 0.19;\n  const f = t - Math.floor(t);\n  if (Math.abs(f - 0.5) < 1e-9) console.log(\"DE tie\", n, t, roundMinor(t, ROUNDING.HALF_EVEN));\n}\n// CA ties\nfor (let n = 1; n < 2000; n++) {\n  const t = n * 0.0725;\n  const f = t - Math.floor(t);\n  if (Math.abs(f - 0.5) < 1e-8) console.log(\"CA near\", n, t, f);\n}\n'", "description": "Probe rounding and FX numeric edge cases"}}
